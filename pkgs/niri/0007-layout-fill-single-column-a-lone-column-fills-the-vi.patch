diff --git a/src/layout/tests.rs b/src/layout/tests.rs
index 82ade9a3..c7c0e806 100644
--- a/src/layout/tests.rs
+++ b/src/layout/tests.rs
@@ -3403,6 +3403,87 @@ fn preset_column_width_fixed_correct_with_border() {
     assert_eq!(win.requested_size().unwrap().w, 500);
 }
 
+#[test]
+fn fill_single_column() {
+    let options = Options {
+        layout: niri_config::Layout {
+            fill_single_column: true,
+            ..Default::default()
+        },
+        ..Default::default()
+    };
+    let width = |layout: &Layout<TestWindow>, id: usize| {
+        let (_, win) = layout.windows().find(|(_, win)| win.0.id == id).unwrap();
+        win.requested_size().unwrap().w
+    };
+
+    // The first window on a workspace opens full-width.
+    let mut layout = check_ops_with_options(options.clone(), [Op::AddOutput(1)]);
+    let size = layout.active_workspace().unwrap().new_window_size(
+        Some(PresetSize::Proportion(0.5)),
+        None,
+        false,
+        &ResolvedWindowRules::default(),
+        (Size::default(), Size::default()),
+    );
+    assert_eq!(size.w, 1248);
+
+    // A lone column fills the view.
+    check_ops_on_layout(
+        &mut layout,
+        [Op::AddWindow {
+            params: TestWindowParams::new(0),
+        }],
+    );
+    assert_eq!(width(&layout, 0), 1248);
+
+    // The next window opens at its own width.
+    let size = layout.active_workspace().unwrap().new_window_size(
+        Some(PresetSize::Proportion(0.5)),
+        None,
+        false,
+        &ResolvedWindowRules::default(),
+        (Size::default(), Size::default()),
+    );
+    assert_eq!(size.w, 616);
+
+    // With two columns, each uses its own width (test windows open at their own 100 px).
+    check_ops_on_layout(
+        &mut layout,
+        [Op::AddWindow {
+            params: TestWindowParams::new(1),
+        }],
+    );
+    assert_eq!(width(&layout, 0), 100);
+    assert_eq!(width(&layout, 1), 100);
+
+    // The column left alone fills the view again.
+    check_ops_on_layout(&mut layout, [Op::CloseWindow(0)]);
+    assert_eq!(width(&layout, 1), 1248);
+
+    // Moving it to an empty workspace keeps it full-width; the next column it joins does not.
+    check_ops_on_layout(
+        &mut layout,
+        [
+            Op::AddWindow {
+                params: TestWindowParams::new(2),
+            },
+            Op::MoveColumnToWorkspaceDown(true),
+        ],
+    );
+    assert_eq!(width(&layout, 1), 1248);
+    assert_eq!(width(&layout, 2), 1248);
+    check_ops_on_layout(&mut layout, [Op::MoveColumnToWorkspaceUp(true)]);
+    assert_eq!(width(&layout, 1), 100);
+    assert_eq!(width(&layout, 2), 100);
+
+    // Turning the option off resizes right away.
+    check_ops_on_layout(&mut layout, [Op::CloseWindow(1)]);
+    assert_eq!(width(&layout, 2), 1248);
+    layout.update_options(Options::default());
+    assert_eq!(width(&layout, 2), 100);
+}
