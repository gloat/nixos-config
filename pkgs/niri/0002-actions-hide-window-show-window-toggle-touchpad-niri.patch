+    /// Windows hidden with [`Self::hide_window`]. They aren't in [`Self::windows`] or
+    /// [`Self::find_window_and_output`], so actions and requests never reach them; only
+    /// [`Self::with_windows`] (IPC), [`Self::with_windows_mut`], [`Self::update_window`] and
+    /// [`Self::remove_window`] see them.
+    pub fn hidden_windows(&self) -> impl Iterator<Item = &W> {
+        self.hidden.iter().map(|r| r.tile.window())
+    }
+
+    pub fn find_hidden(&self, wl_surface: &WlSurface) -> Option<&W> {
+        self.hidden_windows().find(|w| w.is_wl_surface(wl_surface))
+    }
+
+    /// Hides a window: takes it out of its workspace and keeps it, alive, until
+    /// [`Self::show_window`]. Returns whether the window was hidden.
+    pub fn hide_window(&mut self, window: &W::Id) -> bool {
+        if self.is_hidden(window) {
+            return false;
+        }
+
+        let Some(mut removed) = self.remove_window(window, Transaction::new()) else {
+            return false;
+        };
+        removed.tile.stop_move_animations();
+        self.hidden.push(removed);
+        true
+    }
+
+    /// Shows a hidden window on the active workspace of the active output and focuses it. Without
+    /// an id, shows the most recently hidden window. Returns the window that was shown.
+    pub fn show_window(&mut self, window: Option<&W::Id>) -> Option<W::Id> {
+        let idx = match window {
+            Some(window) => self
+                .hidden
+                .iter()
+                .position(|r| r.tile.window().id() == window),
+            None => self.hidden.len().checked_sub(1),
+        };
+        let idx = idx?;
+
+        let MonitorSet::Normal {
+            monitors,
+            active_monitor_idx,
+            ..
+        } = &mut self.monitor_set
+        else {
+            return None;
+        };
+
+        let removed = self.hidden.remove(idx);
+        let id = removed.tile.window().id().clone();
+        let mon = &mut monitors[*active_monitor_idx];
+        let ws_id = mon.active_workspace_ref().id();
+        mon.add_tile(
+            removed.tile,
+            MonitorAddWindowTarget::Workspace {
+                id: ws_id,
+                column_idx: None,
+            },
+            ActivateWindow::Yes,
+            true,
+            removed.width,
+            removed.is_full_width,
+            removed.is_floating,
+        );
+        Some(id)
+    }
+
+    pub fn is_hidden(&self, window: &W::Id) -> bool {
+        self.hidden.iter().any(|r| r.tile.window().id() == window)
+    }
+
     pub fn has_window(&self, window: &W::Id) -> bool {
         self.windows().any(|(_, win)| win.id() == window)
     }
