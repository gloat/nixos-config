+#[test]
+fn hide_and_show_floating_window() {
+    let mut layout = check_ops([
+        Op::AddOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams::new(1),
+        },
+        Op::AddWindow {
+            params: TestWindowParams {
+                is_floating: true,
+                ..TestWindowParams::new(2)
+            },
+        },
+    ]);
+    assert_eq!(layout.focus().map(|w| *w.id()), Some(2));
+
+    assert!(layout.hide_window(&2));
+    assert!(layout.is_hidden(&2));
+    // Hidden windows are out of reach of actions.
+    assert!(!layout.has_window(&2));
+    assert_eq!(layout.hidden_windows().count(), 1);
+    assert_eq!(layout.focus().map(|w| *w.id()), Some(1));
+    // Hiding twice does nothing.
+    assert!(!layout.hide_window(&2));
+    layout.verify_invariants();
+
+    // Shown on another workspace: comes back floating and focused.
+    check_ops_on_layout(&mut layout, [Op::FocusWorkspaceDown]);
+    assert_eq!(layout.show_window(None), Some(2));
+    assert!(!layout.is_hidden(&2));
+    assert_eq!(layout.focus().map(|w| *w.id()), Some(2));
+    let ws = layout.active_workspace().unwrap();
+    assert!(ws.is_floating(&2));
+    layout.verify_invariants();
+}
