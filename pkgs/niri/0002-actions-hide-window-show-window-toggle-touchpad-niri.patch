+    let mut layout = check_ops([
+        Op::AddOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams::new(1),
+        },
+        Op::HideWindow(1),
+        Op::CloseWindow(1),
+    ]);
+    assert!(!layout.has_window(&1));
+    assert_eq!(layout.hidden_windows().count(), 0);
+    assert_eq!(layout.show_window(None), None);
+    layout.verify_invariants();
+}
+
+#[test]
+fn show_window_without_outputs_keeps_it_hidden() {
+    let mut layout = check_ops([
+        Op::AddOutput(1),
+        Op::AddWindow {
+            params: TestWindowParams::new(1),
+        },
+        Op::HideWindow(1),
+        Op::RemoveOutput(1),
+    ]);
+    assert_eq!(layout.show_window(Some(&1)), None);
+    assert!(layout.is_hidden(&1));
+
+    check_ops_on_layout(&mut layout, [Op::AddOutput(2), Op::ShowWindow(Some(1))]);
+    assert!(!layout.is_hidden(&1));
+    assert_eq!(layout.focus().map(|w| *w.id()), Some(1));
+}
