diff --git a/src/input/mod.rs b/src/input/mod.rs
index f1ad4932..bdf41e33 100644
--- a/src/input/mod.rs
+++ b/src/input/mod.rs
@@ -4671,6 +4671,28 @@ fn hardcoded_overview_bind(raw: Keysym, mods: ModifiersState) -> Option<Bind> {
     })
 }
 
+/// Custom acceleration profile: `accel-linear` gives the motion curve; without it, libinput's
+/// custom default (a 1:1 line) applies. Scrolling keeps the fallback curve, so it isn't
+/// accelerated.
+fn apply_custom_accel(
+    device: &mut input::Device,
+    linear: Option<&niri_config::input::AccelLinear>,
+) {
+    let Some(accel) = input::AccelConfig::new(input::AccelProfile::Custom) else {
+        warn!("error creating a custom acceleration config");
+        return;
+    };
+    if let Some(linear) = linear {
+        let (step, points) = linear.points();
+        if let Err(err) = accel.set_points(input::AccelType::Motion, step, &points) {
+            warn!("error setting custom acceleration points: {err:?}");
+        }
+    }
+    if let Err(err) = device.config_accel_apply(accel) {
+        warn!("error applying custom acceleration: {err:?}");
+    }
+}
+
 pub fn apply_libinput_settings(config: &niri_config::Input, device: &mut input::Device) {
     // According to Mutter code, this setting is specific to touchpads.
     let is_touchpad = device.config_tap_finger_count() > 0;
@@ -4703,7 +4725,9 @@ pub fn apply_libinput_settings(config: &niri_config::Input, device: &mut input::
