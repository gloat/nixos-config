+
+    #[test]
+    fn accel_linear_points() {
+        let parsed = do_parse(
+            r#"
+            touchpad {
+                accel-profile "custom"
+                accel-linear 0.2 base=0.5 cap=3
+            }
+            "#,
+        );
+        assert_eq!(parsed.touchpad.accel_profile, Some(AccelProfile::Custom));
+        let (step, points) = parsed.touchpad.accel_linear.unwrap().points();
+
+        // Gain 0.5 * (1 + 0.2 * speed) reaches 0.5 * 3 at speed 10, over 32 segments.
+        assert_eq!(points.len(), 34);
+        assert!((step - 10. / 32.).abs() < 1e-12);
+        assert_eq!(points[0], 0.);
+        let gain = |i: usize| points[i] / (i as f64 * step);
+        assert!((gain(1) - 0.5 * (1. + 0.2 * step)).abs() < 1e-12);
+        assert!((gain(32) - 1.5).abs() < 1e-12);
+        assert!((gain(33) - 1.5).abs() < 1e-12);
+        assert!(points.windows(2).all(|w| w[1] > w[0]));
+    }
+
+    #[test]
+    fn accel_linear_no_rate_is_flat() {
+        let linear = AccelLinear {
+            rate: FloatOrInt(0.),
+            base: Some(FloatOrInt(0.8)),
+            cap: None,
+        };
+        assert_eq!(linear.points(), (1., vec![0., 0.8]));
+    }
 }
