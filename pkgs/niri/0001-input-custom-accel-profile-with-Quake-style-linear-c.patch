+/// Quake-style linear acceleration for `accel-profile "custom"`: the gain grows linearly with
+/// speed, `base * (1 + rate * speed)`, until it reaches `base * cap`, and stays there.
+///
+/// Speed is in device units per millisecond, as libinput's custom profile measures it (no DPI
+/// normalization), so the numbers are specific to each device.
+#[derive(knuffel::Decode, Debug, Clone, Copy, PartialEq)]
+pub struct AccelLinear {
+    #[knuffel(argument)]
+    pub rate: FloatOrInt<0, 100>,
+    #[knuffel(property)]
+    pub base: Option<FloatOrInt<0, 100>>,
+    #[knuffel(property)]
+    pub cap: Option<FloatOrInt<1, 100>>,
+}
+
+impl AccelLinear {
+    /// The curve as libinput custom-profile points: output speed at input speeds `0, step, 2 *
+    /// step, ...`. libinput extends the last segment linearly, which is exact once the gain is
+    /// capped.
+    pub fn points(&self) -> (f64, Vec<f64>) {
+        let rate = self.rate.0;
+        let base = self.base.map_or(1., |b| b.0);
+        let cap = self.cap.map_or(3., |c| c.0);
+        if rate <= 0. || cap <= 1. {
+            return (1., vec![0., base]);
+        }
+
+        // Speed at which the gain reaches the cap; 32 segments up to it, then one past it.
+        let knee = (cap - 1.) / rate;
+        let step = knee / 32.;
+        let points = (0..=33)
+            .map(|i| {
+                let speed = f64::from(i) * step;
+                base * speed * (1. + rate * speed).min(cap)
+            })
+            .collect();
+        (step, points)
+    }
+}
+
 #[derive(Debug, Clone, Copy, PartialEq, Eq)]
