@@ -2467,4 +2469,37 @@ mod tests {
         "#,
         );
     }
+
+    #[test]
+    fn window_rule_animations() {
+        let parsed = do_parse(
+            r#"
+            window-rule {
+                match app-id="popup"
+                window-open {
+                    duration-ms 90
+                    custom-shader "vec4 open_color(vec3 c, vec3 s) { return vec4(0.0); }"
+                }
+                window-close { off; }
+            }
+            "#,
+        );
+        let rule = &parsed.window_rules[0];
+        let open = rule.window_open.as_ref().unwrap();
+        assert!(open
+            .custom_shader
+            .as_deref()
+            .unwrap()
+            .contains("open_color"));
+        assert!(matches!(
+            open.anim.kind,
+            animations::Kind::Easing(animations::EasingParams {
+                duration_ms: 90,
+                ..
+            })
+        ));
+        let close = rule.window_close.as_ref().unwrap();
+        assert!(close.anim.off);
+        assert_eq!(close.custom_shader, None);
+    }
 }
