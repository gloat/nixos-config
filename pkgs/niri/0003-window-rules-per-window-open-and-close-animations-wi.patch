+
+/// Which shader a window's open or close animation draws with.
+#[derive(Debug, Clone, PartialEq)]
+pub enum AnimShader {
+    /// The global `animations` custom-shader, if there is one.
+    Global,
+    /// A window rule's animation: its custom-shader, or `None` for niri's built-in animation.
+    Rule(Option<Rc<str>>),
+}
+
+impl AnimShader {
+    pub fn from_rule(custom_shader: Option<&str>) -> Self {
+        Self::Rule(custom_shader.map(Rc::from))
+    }
+
+    /// The program to draw with, or `None` for the built-in animation.
+    pub fn program(&self, renderer: &mut GlesRenderer, is_open: bool) -> Option<ProgramType> {
+        match self {
+            AnimShader::Global => {
+                let ty = if is_open {
+                    ProgramType::Open
+                } else {
+                    ProgramType::Close
+                };
+                Shaders::get(renderer).program(ty).map(|_| ty)
+            }
+            AnimShader::Rule(None) => None,
+            AnimShader::Rule(Some(src)) => rule_program(renderer, is_open, src),
+        }
+    }
 }
 
