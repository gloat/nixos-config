+/// A window rule's open or close shader, compiled once per distinct source.
+fn rule_program(renderer: &mut GlesRenderer, is_open: bool, src: &Rc<str>) -> Option<ProgramType> {
+    let programs = Shaders::get(renderer).rule_programs.borrow();
+    let found = programs
+        .iter()
+        .position(|p| p.is_open == is_open && p.src == *src);
+    if let Some(idx) = found {
+        return programs[idx]
+            .program
+            .is_some()
+            .then_some(ProgramType::Rule(idx));
+    }
+    drop(programs);
+
+    let program = if is_open {
+        compile_open_program(renderer, src)
+    } else {
+        compile_close_program(renderer, src)
+    };
+    let program = program
+        .map_err(|err| warn!("error compiling a window rule's animation shader: {err:?}"))
+        .ok();
+
+    let mut programs = Shaders::get(renderer).rule_programs.borrow_mut();
+    let ok = program.is_some();
+    programs.push(RuleProgram {
+        is_open,
+        src: src.clone(),
+        program,
+    });
+    ok.then_some(ProgramType::Rule(programs.len() - 1))
+}
