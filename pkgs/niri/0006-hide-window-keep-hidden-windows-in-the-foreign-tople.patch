From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gloat <4354076+gloat@users.noreply.github.com>
Date: Sat, 24 Oct 2026 11:02:47 -0500
Subject: [PATCH] hide-window: keep hidden windows in the foreign-toplevel list

The closed-window check didn't see hidden windows, so every refresh closed
the hidden toplevel and re-announced it as new; bars listing toplevels
(noctalia) spun at 100% CPU.
---
 src/protocols/foreign_toplevel.rs | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/protocols/foreign_toplevel.rs b/src/protocols/foreign_toplevel.rs
index 11379169..287701cb 100644
--- a/src/protocols/foreign_toplevel.rs
+++ b/src/protocols/foreign_toplevel.rs
@@ -97,7 +97,11 @@ pub fn refresh(state: &mut State) {
 
     // Handle closed windows.
     protocol_state.toplevels.retain(|surface, data| {
-        if state.niri.layout.find_window_and_output(surface).is_some() {
+        // Hidden windows stay listed: with_windows() below includes them, so closing them here
+        // would re-announce them as new on every refresh.
+        let layout = &state.niri.layout;
+        if layout.find_window_and_output(surface).is_some() || layout.find_hidden(surface).is_some()
+        {
             return true;
         }
 
